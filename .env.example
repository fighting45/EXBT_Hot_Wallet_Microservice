# ============================================
# EXBT Wallet Service - Production Configuration
# ============================================

# Application
NODE_ENV=production
PORT=3500

# Set to false to disable withdrawal requests (returns 503 maintenance response)
WITHDRAWAL_ENABLED=true

# Laravel Integration
LARAVEL_URL=https://your-production-domain.com
LARAVEL_API_SECRET=CHANGE_THIS_TO_64_CHAR_HEX_KEY

# Auto-start Listener on boot
AUTO_START_LISTENERS=true

# PostgreSQL Database
DB_HOST=your-db-host.com
DB_PORT=5432
DB_USERNAME=exbt_service
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_DATABASE=exbt_wallet
DB_SYNCHRONIZE=false  # CRITICAL: Must be false in production
DB_LOGGING=false

# Master Encryption Password (64-char hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match WALLET_MASTER_PASSWORD in Laravel .env
MASTER_PASSWORD=CHANGE_THIS_TO_64_CHAR_HEX_KEY

# ============================================
# EXBT Chain (EVM)
# ============================================
EXBT_RPC_URL=https://testnet_rpc.exbotix.net
EXBT_CHAIN_ID=11211

# Hot wallet private key — funds withdrawals and seeds gas for sweeps
# CRITICAL: Never commit this value
EXBT_HOT_WALLET_KEY=0x_YOUR_HOT_WALLET_PRIVATE_KEY_HERE

# ============================================
# Scanner
# ============================================
SCANNER_POLL_INTERVAL_MS=60000
# Set to current block on first deploy to skip old history
# Leave 0 to resume from DB cursor on restarts
SCANNER_START_BLOCK=0
# Only scan blocks this many behind chain head — lets RPC fully index before we read
SCANNER_CONFIRMATION_DEPTH=12

# ============================================
# Signal Scanner (Sniper Confluence Strategy)
# ============================================
# Set SIGNAL_ENABLED=true to activate the background signal scanner.
SIGNAL_ENABLED=false

# Symbol to monitor (KuCoin format: BASE-QUOTE, e.g. BTC-USDT, ETH-USDT)
SIGNAL_SYMBOL=BTC-USDT

# Primary timeframe: 1m 3m 5m 15m 30m 1h 2h 4h 6h 8h 12h 1d
SIGNAL_INTERVAL=1h

# Secondary timeframe for RSI confirmation (must be <= primary)
SIGNAL_SECONDARY_INTERVAL=5m

# EMA periods (Pine Script defaults: 9 / 21)
SIGNAL_FAST_EMA=9
SIGNAL_SLOW_EMA=21

# Minimum confluence score out of 7 to fire a signal
SIGNAL_MIN_CONFLUENCE=4

# ATR settings for SL/TP calculation
SIGNAL_ATR_PERIOD=14
SIGNAL_ATR_SL_MULTIPLIER=1.5

# Number of TP levels to include in webhook payload (1–5)
SIGNAL_TP_COUNT=5

# Webhook endpoint on Laravel that receives signal events
# Defaults to ${LARAVEL_URL}/api/v1/signals/webhook if not set
SIGNAL_WEBHOOK_URL=

# HMAC secret for X-Signature header — defaults to LARAVEL_API_SECRET if not set
SIGNAL_WEBHOOK_SECRET=

# Override KuCoin base URL (e.g. for a proxy)
SIGNAL_KUCOIN_URL=https://api.kucoin.com

# ============================================
# Security Notes:
# ============================================
# 1. LARAVEL_API_SECRET must match WALLET_API_SECRET in Laravel .env
# 2. Never commit this file to git
# 3. Generate new secrets for each environment
# 4. Keep MASTER_PASSWORD secure — losing it means losing access to all derived addresses
# 5. EXBT_HOT_WALLET_KEY provides FULL ACCESS to the hot wallet
#    - Keep this secret extremely secure
#    - Monitor hot wallet balance regularly
#    - Top up from cold storage as needed
# ============================================
